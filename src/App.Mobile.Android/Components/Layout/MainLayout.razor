@inherits LayoutComponentBase
@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Services.Abstractions.IMobileAccessContext AccessContext

<div class="layout-shell">
    <aside class="shell-sidebar">
        <NavMenu />
    </aside>

    <main class="shell-main">
        @if (!string.IsNullOrWhiteSpace(BannerText))
        {
            <div class="shell-banner" role="status">
                <span class="shell-banner-label">@MobileUiText.ShellBannerLabel</span>
                <span>@BannerText</span>
            </div>
        }

        <section class="shell-content">
            @Body
        </section>
    </main>
</div>

@code {
    private string BannerText => AccessContext.GetBannerText();
}
