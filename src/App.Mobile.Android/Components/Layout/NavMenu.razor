@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Navigation.MobileViewRegistry ViewRegistry
@inject global::App.Mobile.Android.Services.Abstractions.IMobileAccessContext AccessContext

<div class="nav-shell">
    <div class="nav-header">
        <div class="nav-title">@MobileUiText.ApplicationTitle</div>
        <div class="nav-subtitle">@MobileUiText.NavigationSubtitle</div>
    </div>

    <nav class="menu-list">
        @foreach (var entry in ViewRegistry.GetVisibleMenuEntries(AccessContext))
        {
            <NavLink class="nav-link"
                     href="@entry.Route"
                     Match="@(entry.ViewId == global::App.Mobile.Android.Navigation.MobileViewId.Home ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <span class="@entry.IconCssClass" aria-hidden="true"></span>
                <span>@entry.Title</span>
            </NavLink>
        }
    </nav>
</div>
