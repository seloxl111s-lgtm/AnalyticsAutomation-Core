@page "/upload"
@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Navigation.MobileNavigationState NavigationState
@inject global::App.Mobile.Android.Services.Abstractions.IFeatureFlagReader FeatureFlagReader
@inject global::App.Mobile.Android.Services.Abstractions.IMobileMediaService MobileMediaService
@inject global::App.Mobile.Android.Services.Abstractions.IMobileSelectedMediaStore SelectedMediaStore
@inject global::App.Mobile.Android.Services.Abstractions.IMobileOutboxService MobileOutboxService
@inject global::App.Mobile.Android.Services.Abstractions.ILocalDuplicatePrecheckService DuplicatePrecheckService

<h1>@MobileUiText.UploadTitle</h1>
<p>@MobileUiText.UploadIntro</p>

<section class="media-capability-card">
    <div class="media-card-header">
        <h2>@MobileUiText.UploadCapabilityCardTitle</h2>
        <span class="media-local-badge">@MobileUiText.UploadLocalDeviceBadge</span>
    </div>

    <p class="media-summary">@CapabilitySummaryText</p>

    <dl class="media-capability-list">
        <div>
            <dt>@MobileUiText.UploadFilePickerLabel</dt>
            <dd>@GetCapabilityStateText(CapabilitySnapshot?.FilePickerSeamState)</dd>
        </div>
        <div>
            <dt>@MobileUiText.UploadGalleryVideoLabel</dt>
            <dd>@GetCapabilityStateText(CapabilitySnapshot?.GalleryVideoSeamState)</dd>
        </div>
        <div>
            <dt>@MobileUiText.UploadCameraCaptureLabel</dt>
            <dd>@GetCapabilityStateText(CapabilitySnapshot?.CameraCaptureSeamState)</dd>
        </div>
    </dl>

    <div class="media-action-row">
        <button type="button" class="btn btn-primary" @onclick="SelectVideoAsync">@MobileUiText.UploadSelectVideoButton</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CaptureVideoAsync">@MobileUiText.UploadCaptureVideoButton</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(MediaResultText))
    {
        <p class="media-result">@MediaResultText</p>
    }
</section>

@if (CurrentSelectedMedia is not null)
{
    <section class="selected-media-card">
        <h3>@MobileUiText.UploadSelectedMediaCardTitle</h3>

        <dl class="selected-media-grid">
            <div>
                <dt>@MobileUiText.UploadSelectedMediaSourceLabel</dt>
                <dd>@MobileUiText.GetSelectedMediaSourceText(CurrentSelectedMedia.Source)</dd>
            </div>
            <div>
                <dt>@MobileUiText.UploadSelectedMediaFileNameLabel</dt>
                <dd>@CurrentSelectedMedia.FileName</dd>
            </div>
            <div>
                <dt>@MobileUiText.UploadSelectedMediaContentTypeLabel</dt>
                <dd>@GetSelectedMediaContentTypeText(CurrentSelectedMedia.ContentType)</dd>
            </div>
            <div>
                <dt>@MobileUiText.UploadSelectedMediaSelectedAtLabel</dt>
                <dd>@FormatSelectedAt(CurrentSelectedMedia.SelectedAtUtc)</dd>
            </div>
            <div>
                <dt>@MobileUiText.UploadSelectedMediaStateLabel</dt>
                <dd>@MobileUiText.GetUploadSelectedMediaStateText(CurrentSelectedMedia.HasLocalReadHandle)</dd>
            </div>
        </dl>

        @if (!CurrentSelectedMedia.HasLocalReadHandle)
        {
            <p class="selected-media-note selected-media-note-repair">@MobileUiText.UploadSelectedMediaRestoredMetadataNoteText</p>
        }

        <div class="selected-media-actions">
            <button type="button" class="btn btn-outline-danger" @onclick="ClearSelectedMediaAsync">@MobileUiText.UploadClearSelectionButton</button>
        </div>
    </section>
}

@if (CurrentSelectedMedia is not null && CurrentPrecheckResult is not null)
{
    <section class="precheck-card">
        <h3>@MobileUiText.LocalDuplicatePrecheckCardTitle</h3>

        <dl class="precheck-grid">
            <div>
                <dt>@MobileUiText.LocalDuplicatePrecheckStatusLabel</dt>
                <dd>@MobileUiText.GetLocalDuplicatePrecheckStatusText(CurrentPrecheckResult.Status)</dd>
            </div>
        </dl>

        <p class="precheck-message">@CurrentPrecheckResult.Message</p>
        <p class="precheck-note">@MobileUiText.LocalDuplicatePrecheckLocalOnlyNote</p>
    </section>
}

@if (ShowQueueFoundationAction)
{
    <section class="outbox-foundation-block">
        <p class="outbox-foundation-hint">@MobileUiText.UploadOutboxActionHint</p>
        <button type="button" class="btn btn-outline-primary" @onclick="EnqueueStubItemAsync">@MobileUiText.UploadEnqueueStubButton</button>

        @if (!string.IsNullOrWhiteSpace(OutboxResultText))
        {
            <p class="@(OutboxResultIsWarning ? "outbox-result outbox-result-warning" : "outbox-result")">@OutboxResultText</p>
        }
    </section>
}

@code {
    private global::App.Mobile.Android.Media.MobileMediaCapabilitySnapshot? CapabilitySnapshot { get; set; }

    private global::App.Mobile.Android.Media.LocalSelectedMediaDescriptor? CurrentSelectedMedia { get; set; }

    private global::App.Mobile.Android.DuplicatePrecheck.LocalDuplicatePrecheckResult? CurrentPrecheckResult { get; set; }

    private string MediaResultText { get; set; } = string.Empty;

    private string OutboxResultText { get; set; } = string.Empty;

    private bool OutboxResultIsWarning { get; set; }

    private bool ShowQueueFoundationAction =>
        FeatureFlagReader.IsEnabled(global::App.Mobile.Android.Services.Stubs.StubFeatureFlagReader.QueueFoundationCardFlag);

    private string CapabilitySummaryText =>
        CapabilitySnapshot?.SummaryText
        ?? MobileUiText.UploadLoadingCapabilitySnapshot;

    protected override async Task OnInitializedAsync()
    {
        NavigationState.SetCurrentView(global::App.Mobile.Android.Navigation.MobileViewId.Upload);
        CapabilitySnapshot = await MobileMediaService.GetCapabilitySnapshotAsync();
        await RefreshCurrentSelectionAndPrecheckAsync();
    }

    private async Task SelectVideoAsync()
    {
        var result = await MobileMediaService.PickVideoAsync();
        MediaResultText = result.Message;
        OutboxResultText = string.Empty;
        OutboxResultIsWarning = false;
        await RefreshCurrentSelectionAndPrecheckAsync();
    }

    private async Task CaptureVideoAsync()
    {
        var result = await MobileMediaService.CaptureVideoAsync();
        MediaResultText = result.Message;
        OutboxResultText = string.Empty;
        OutboxResultIsWarning = false;
        await RefreshCurrentSelectionAndPrecheckAsync();
    }

    private async Task ClearSelectedMediaAsync()
    {
        await SelectedMediaStore.ClearAsync();
        MediaResultText = MobileUiText.UploadClearSelectionResultText;
        OutboxResultText = string.Empty;
        OutboxResultIsWarning = false;
        await RefreshCurrentSelectionAndPrecheckAsync();
    }

    private async Task EnqueueStubItemAsync()
    {
        var result = await MobileOutboxService.EnqueueCurrentSelectionAsync();
        OutboxResultText = result.Message;
        OutboxResultIsWarning = !result.Applied;
        MediaResultText = string.Empty;
        await RefreshCurrentSelectionAndPrecheckAsync();
    }

    private async Task RefreshCurrentSelectionAndPrecheckAsync()
    {
        CurrentSelectedMedia = await SelectedMediaStore.GetCurrentAsync();

        if (CurrentSelectedMedia is null)
        {
            CurrentPrecheckResult = null;
            return;
        }

        var items = await MobileOutboxService.GetItemsAsync();
        CurrentPrecheckResult = DuplicatePrecheckService.CheckAgainstOutbox(CurrentSelectedMedia, items);
    }

    private static string GetCapabilityStateText(global::App.Mobile.Android.Media.MobileMediaCapabilityState? state)
    {
        return state is null
            ? MobileUiText.UploadLoadingCapabilitySnapshot
            : MobileUiText.GetMediaCapabilityStateText(state.Value);
    }

    private static string GetSelectedMediaContentTypeText(string? contentType)
    {
        return string.IsNullOrWhiteSpace(contentType)
            ? MobileUiText.UploadUnknownContentTypeText
            : contentType;
    }

    private static string FormatSelectedAt(DateTimeOffset selectedAtUtc)
    {
        return selectedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");
    }
}
